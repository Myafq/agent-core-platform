#!/usr/bin/env python3
"""Mint one temporary GitHub App credential through the scoped Lambda broker."""

from __future__ import annotations

import json
import os
import re
import sys

import boto3


NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$")


def fail() -> None:
    print("github credential unavailable", file=sys.stderr)
    raise SystemExit(1)


if len(sys.argv) != 3 or not all(NAME.fullmatch(value) for value in sys.argv[1:]):
    fail()

function_name = os.environ.get("GITHUB_APP_TOKEN_BROKER_FUNCTION_NAME")
region = os.environ.get("AWS_REGION") or os.environ.get("AWS_DEFAULT_REGION")
if not function_name or not region:
    fail()

try:
    response = boto3.client("lambda", region_name=region).invoke(
        FunctionName=function_name,
        InvocationType="RequestResponse",
        Payload=json.dumps({"operation": "mintGitCredential", "owner": sys.argv[1], "repo": sys.argv[2]}).encode(),
    )
    payload = json.loads(response["Payload"].read())
    token = payload.get("token")
except Exception:
    fail()

if response.get("FunctionError") or not isinstance(token, str) or not token:
    fail()

print(token)
