#!/usr/bin/env python3
"""Git credential helper that keeps the App token out of repository config."""

from __future__ import annotations

import subprocess
import sys
from urllib.parse import unquote


if len(sys.argv) != 2 or sys.argv[1] != "get":
    raise SystemExit(0)

request = dict(line.split("=", 1) for line in sys.stdin.read().splitlines() if "=" in line)
if request.get("protocol") != "https" or request.get("host") != "github.com":
    raise SystemExit(0)

parts = [part for part in unquote(request.get("path", "")).removesuffix(".git").split("/") if part]
if len(parts) != 2:
    raise SystemExit(0)

result = subprocess.run(["/usr/local/bin/github-app-token", *parts], capture_output=True, text=True, check=False)
if result.returncode != 0 or not result.stdout.strip():
    raise SystemExit(1)

print("username=x-access-token")
print(f"password={result.stdout.strip()}")
