{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-v1alpha1.schema.json",
  "title": "AgentCore declarative agent v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "agentcore.example/v1alpha1"
    },
    "kind": {
      "const": "Agent"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "tags": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "model", "instructions", "limits"],
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "harness"},
            "container": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image"],
              "properties": {
                "image": {
                  "type": "string",
                  "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z][a-z0-9-]*[a-z0-9]\\.amazonaws\\.com/[a-z0-9]+(?:[._/-][a-z0-9]+)*@sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id"],
          "properties": {
            "provider": {"const": "bedrock"},
            "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
            "apiFormat": {"enum": ["converse_stream", "responses", "chat_completions"]},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "topP": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system"],
          "properties": {
            "system": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slack": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 35,
                  "pattern": "^[^\\r\\n]+$"
                }
              }
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "builtins": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["shell", "file_operations"]}
            },
            "codeInterpreter": {"type": "boolean"},
            "gateways": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["github-app-tool"]}
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxIterations", "maxTokens", "timeoutSeconds"],
          "properties": {
            "maxIterations": {"type": "integer", "minimum": 1, "maximum": 100},
            "maxTokens": {"type": "integer", "minimum": 1},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
          }
        }
      }
    }
  }
}
